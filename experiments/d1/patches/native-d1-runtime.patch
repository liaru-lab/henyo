+    // Retain projection padding and the true FFN row count.
+    if(strstr(w->name,".ffn_")!=NULL)pad=0;
+    if(pad&&n<pad){henyo_d1_T *p=ggml_pad(c,x,0,pad-n,0,0);henyo_d1_T *y=ggml_mul_mat(c,w,p);return ggml_view_2d(c,y,y->ne[0],n,y->nb[1],0);}
+    return ggml_mul_mat(c,w,x);
+}
+struct henyo_d1_memo{henyo_d1_T *a,*value;};
+struct henyo_d1_select_context {struct ggml_context *ctx;henyo_d1_T *ids;int64_t nt;struct henyo_d1_memo cache[256];int count;};
+static int henyo_d1_layer_weight(henyo_d1_T *w){return w&&(strstr(w->name,"blk.22.")==w->name||strstr(w->name,"blk.23.")==w->name);}
+static henyo_d1_T *henyo_d1_select_rows(struct henyo_d1_select_context *s,henyo_d1_T *a){
