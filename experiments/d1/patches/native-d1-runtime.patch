diff --git a/ggml/src/ggml-hexagon/htp/henyo-stencil.h b/ggml/src/ggml-hexagon/htp/henyo-stencil.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/henyo-stencil.h
@@ -0,0 +1,42 @@
+// Experimental channel-contiguous seven-tap stencil for the pinned HTP ABI.
+// src0's allocation is [2048, nt+6]; the host passes a same-size contiguous
+// reshape so the original operation descriptor can carry it unchanged.
+#define HENYO_STENCIL_MARKER 0x484e5901
+static inline HVX_Vector henyo_mul(HVX_Vector a,HVX_Vector b) {
+    return Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(a,b));
+}
+static inline HVX_Vector henyo_add(HVX_Vector a,HVX_Vector b) {
+    return Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_VsfVsf(a,b));
+}
+static void henyo_stencil_worker(unsigned int nth,unsigned int ith,void *data) {
+    struct htp_ops_context *octx=(struct htp_ops_context *)data;
+    const float *src=(const float *)(uintptr_t)octx->src[0]->data;
+    const float *weights=(const float *)(uintptr_t)octx->src[1]->data;
+    float *out=(float *)(uintptr_t)octx->dst->data;
+    const uint32_t channels=2048,nt=octx->dst->ne[1];
+    for(uint32_t cb=ith*32;cb<channels;cb+=nth*32) {
+        float taps[7][32] __attribute__((aligned(128)));
+        for(int k=0;k<7;++k)for(int j=0;j<32;++j)taps[k][j]=weights[(cb+j)*7+k];
+        const HVX_Vector w0=*(const HVX_Vector *)taps[0],w1=*(const HVX_Vector *)taps[1],
+                         w2=*(const HVX_Vector *)taps[2],w3=*(const HVX_Vector *)taps[3],
+                         w4=*(const HVX_Vector *)taps[4],w5=*(const HVX_Vector *)taps[5],
+                         w6=*(const HVX_Vector *)taps[6];
+        HVX_Vector x0=*(const HVX_Vector *)(src+cb),x1=*(const HVX_Vector *)(src+channels+cb),
+                   x2=*(const HVX_Vector *)(src+2*channels+cb),x3=*(const HVX_Vector *)(src+3*channels+cb),
+                   x4=*(const HVX_Vector *)(src+4*channels+cb),x5=*(const HVX_Vector *)(src+5*channels+cb);
+        for(uint32_t t=0;t<nt;++t) {
+            HVX_Vector x6=*(const HVX_Vector *)(src+(t+6)*channels+cb);
+            HVX_Vector sum=henyo_mul(x0,w0);
+            sum=henyo_add(sum,henyo_mul(x1,w1));sum=henyo_add(sum,henyo_mul(x2,w2));
+            sum=henyo_add(sum,henyo_mul(x3,w3));sum=henyo_add(sum,henyo_mul(x4,w4));
+            sum=henyo_add(sum,henyo_mul(x5,w5));sum=henyo_add(sum,henyo_mul(x6,w6));
+            *(HVX_Vector *)(out+t*channels+cb)=sum;
+            x0=x1;x1=x2;x2=x3;x3=x4;x4=x5;x5=x6;
+        }
+    }
+}
+static int henyo_stencil(struct htp_ops_context *octx) {
+    if(octx->dst->ne[0]!=2048||octx->src[1]->ne[0]!=7||octx->dst->ne[2]!=1)return HTP_STATUS_INVAL_PARAMS;
+    work_queue_run(octx->ctx->work_queue,henyo_stencil_worker,octx,octx->n_threads);
+    return HTP_STATUS_OK;
+}
