+    }
+    if(!out)out=henyo_d1_rows(c,a,s->ids);
+    if(s->count>=256)abort();s->cache[s->count++]=(struct henyo_d1_memo){a,out};return out;
+}
+struct henyo_d1_saved {struct ggml_context *ctx;henyo_d1_T *ids,*prev,*packed_prev,*ends;};
+static _Thread_local struct henyo_d1_saved henyo_d1_saved;
+static int henyo_d1_guarded;
+static henyo_d1_T *henyo_d1_unwrap(henyo_d1_T *a){while(a&&a->op==GGML_OP_RESHAPE)a=a->src[0];return a;}
+// Recognize the original last-block expression, including round2's NPU marker.
+static henyo_d1_T *henyo_d1_find_bcx(henyo_d1_T *conv){
+    conv=henyo_d1_unwrap(conv);if(!conv||conv->op!=GGML_OP_SSM_CONV)return NULL;
+    henyo_d1_T *sx=conv->src[0],*m=NULL;
+    if(conv->op_params[0]==0x484e5901){sx=henyo_d1_unwrap(sx);if(sx&&sx->op==GGML_OP_PAD)m=sx->src[0];}
+    else if(sx&&sx->op==GGML_OP_PAD){sx=henyo_d1_unwrap(sx->src[0]);if(sx&&sx->op==GGML_OP_CONT)sx=sx->src[0];if(sx&&sx->op==GGML_OP_TRANSPOSE)m=sx->src[0];}
+    if(!m||m->op!=GGML_OP_MUL)return NULL;
+    henyo_d1_T *b=m->src[0],*x=m->src[1];
+    return b&&x&&b->op==GGML_OP_VIEW&&x->op==GGML_OP_VIEW&&b->src[0]==x->src[0]?b->src[0]:NULL;
+}
+henyo_d1_T *ggml_get_rows(struct ggml_context *c,henyo_d1_T *a,henyo_d1_T *ids){
+    if(!henyo_d1_enabled("HENYO_D1_SELECT_LAST")||henyo_d1_guarded)return henyo_d1_rows(c,a,ids);
+    if(henyo_d1_saved.ctx==c&&henyo_d1_saved.ids==ids&&henyo_d1_saved.prev==a){henyo_d1_T *out=henyo_d1_rows(c,henyo_d1_saved.packed_prev,henyo_d1_saved.ends);henyo_d1_saved=(struct henyo_d1_saved){0};return out;}
+    if(!strstr(a->name,"post_operator_norm-23")||a->op!=GGML_OP_MUL||a->ne[1]<=32||7*ggml_nelements(ids)>=a->ne[1])return henyo_d1_rows(c,a,ids);
+    const char *minimum=getenv("HENYO_D1_SELECT_MIN_TOKENS");if(minimum&&a->ne[1]<atoi(minimum))return henyo_d1_rows(c,a,ids);
+    henyo_d1_T *norm=a->src[0],*gamma=a->src[1];
+    if(norm->op!=GGML_OP_RMS_NORM)return henyo_d1_rows(c,a,ids);
+    henyo_d1_T *outproj=norm->src[0];if(outproj->op!=GGML_OP_MUL_MAT||!strstr(outproj->src[0]->name,"blk.23.shortconv.out_proj"))return henyo_d1_rows(c,a,ids);
+    henyo_d1_T *gated=outproj->src[1];if(gated->op!=GGML_OP_MUL)return henyo_d1_rows(c,a,ids);
+    henyo_d1_T *cv=henyo_d1_find_bcx(gated->src[0])?gated->src[0]:gated->src[1];henyo_d1_T *bcx=henyo_d1_find_bcx(cv);cv=henyo_d1_unwrap(cv);
+    if(!bcx||bcx->op!=GGML_OP_MUL_MAT||!strstr(bcx->src[0]->name,"blk.23.shortconv.in_proj"))return henyo_d1_rows(c,a,ids);
+    henyo_d1_T *input=bcx->src[1];if(input->ne[2]!=1||input->ne[3]!=1)return henyo_d1_rows(c,a,ids);
+    henyo_d1_guarded=1;henyo_d1_T *near=henyo_d1_index_tensor(c,ids,0),*mask=henyo_d1_index_tensor(c,ids,1),*ends=henyo_d1_index_tensor(c,ids,2);
+    struct henyo_d1_select_context sel={.ctx=c,.ids=near,.nt=a->ne[1]};
+    henyo_d1_T *prev=NULL,*packed_prev=NULL;
+    if(input->op==GGML_OP_MUL&&input->src[0]->op==GGML_OP_RMS_NORM)prev=input->src[0]->src[0];
+    henyo_d1_T *picked=ggml_mul(c,henyo_d1_select_rows(&sel,input),mask);
+    if(prev){for(int i=0;i<sel.count;++i)if(sel.cache[i].a==prev)packed_prev=sel.cache[i].value;}
+    henyo_d1_T *small=henyo_d1_matrix(c,bcx->src[0],picked);int64_t n=small->ne[1];
+    henyo_d1_T *b=ggml_view_2d(c,small,2048,n,small->nb[1],0),*x=ggml_view_2d(c,small,2048,n,small->nb[1],2*2048*4),*gate=ggml_view_2d(c,small,2048,n,small->nb[1],2048*4);
+    henyo_d1_T *bx=ggml_cont(c,ggml_transpose(c,ggml_mul(c,b,x)));bx=ggml_pad_ext(c,bx,6,0,0,0,0,0,0,0);
+    henyo_d1_T *conv=ggml_ssm_conv(c,bx,cv->src[1]);henyo_d1_T *end_conv=henyo_d1_rows(c,ggml_reshape_2d(c,conv,2048,n),ends),*end_gate=henyo_d1_rows(c,gate,ends);
