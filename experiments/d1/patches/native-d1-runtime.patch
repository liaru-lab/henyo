+
+// Local pinned-ABI experiment, adapted from MIT-licensed Tandem commit
+// 6fed0a4555e72f23c9bfa982aa5cbec24b5ed5df. Reserved byte marks paired epilogue.
+static bool fuse_d1_swiglu(const ggml_hexagon_session *sess,htp_opnode &prev,const htp_opnode &cur){
+ const char *flag=getenv("HENYO_D1_PAIR_GLU");if(!flag||atoi(flag)!=1)return false;
+ if(prev.opcode!=HTP_OP_MUL_MAT_NX||prev.inputs.size()!=3||prev.outputs.size()!=2)return false;
+ const auto *g=cur.node->src[0],*u=cur.node->src[1],*d=cur.node;
+ if(!g||!u||ggml_get_op_params_i32(d,1)!=0||!htp_tensor_is_fuseable(g)||!htp_tensor_is_fuseable(u))return false;
+ int ig=g==prev.outputs[0]&&u==prev.outputs[1]?0:g==prev.outputs[1]&&u==prev.outputs[0]?1:-1;if(ig<0)return false;
+ auto kp=*prev.kparams<htp_mm_kernel_params>();
+ if(!kp.n_hmx||kp.kernel_type!=HTP_MM_KERNEL_HMX_2D||kp.n_weights!=2)return false;
+ auto *wg=prev.inputs[ig],*wu=prev.inputs[1-ig],*x=prev.inputs[2];
+ const char *mx=getenv("HENYO_D1_PAIR_MAX_TOKENS");if(mx&&atoi(mx)>0&&x->ne[1]>atoi(mx))return false;
+ if(wg->type!=GGML_TYPE_Q4_K||wg->ne[0]!=2048||wg->ne[1]!=7680||wu->type!=wg->type||!ggml_are_same_shape(wg,wu))return false;
+ if(x->type!=GGML_TYPE_F32||d->type!=GGML_TYPE_F32||!ggml_is_contiguous(g)||!ggml_is_contiguous(u)||!ggml_is_contiguous(d)||!ggml_are_same_shape(g,d)||!ggml_are_same_shape(u,d))return false;
+ if(htp_inputs_overlap_unsafe(prev,d))return false;
+ kp.n_chunk=kp.n_chunk/64*64;if(kp.n_chunk<64)return false;kp.unused=0xd1;
+ prev.inputs={wg,wu,x};prev.outputs={d};prev.fused.push_back(cur.node);prev.set_kparams(kp);
+ return true;
+}
+
 bool htp_fusion_try_fuse(const struct ggml_hexagon_session * sess, struct htp_opnode & prev, const struct htp_opnode & cur) {
     if (!opt_opfusion) return false;
 
+    if(cur.opcode==HTP_OP_GLU_SWIGLU && fuse_d1_swiglu(sess,prev,cur))return true;
     switch (cur.opcode) {
         case HTP_OP_ADD:
             return (htp_fusion_enabled(HTP_FUSE_ALLREDUCE_ADD) && fuse_allreduce_add(sess, prev, cur)) ||
@@ -647,3 +671,22 @@ bool htp_fusion_try_fuse(const struct ggml_hexagon_session * sess, struct htp_op
             return false;
     }
 }
+
+// Local pinned-ABI experiment: preserve both residual and normalized outputs.
+bool htp_fusion_try_residual(const ggml_hexagon_session *sess,htp_opnode &add,const htp_opnode &norm){
+ (void)sess;const char *e=getenv("HENYO_D1_RESIDUAL_NORM");if(!e||atoi(e)!=1)return false;
+ if(add.opcode!=HTP_OP_ADD||add.inputs.size()!=2||add.outputs.size()!=1||!add.fused.empty())return false;
+ if(norm.opcode!=HTP_OP_RMS_NORM_MUL||norm.inputs.size()!=2||norm.outputs.size()!=1)return false;
+ const auto *a=add.inputs[0],*b=add.inputs[1],*sum=add.outputs[0],*w=norm.inputs[1],*out=norm.outputs[0];
+ if(norm.inputs[0]!=sum||a->ne[0]!=2048||a->ne[2]!=1||a->ne[3]!=1)return false;
+ for(auto *t:{a,b,sum,out})if(t->type!=GGML_TYPE_F32||!ggml_are_same_shape(a,t)||!ggml_is_contiguous(t))return false;
+ if(w->type!=GGML_TYPE_F32||ggml_nelements(w)!=2048||!ggml_is_contiguous(w))return false;
+ if(htp_tensors_overlap(sum,out)||htp_tensors_overlap(w,sum)||htp_tensors_overlap(w,out))return false;
+ if(htp_inputs_overlap_unsafe(add,out)||htp_inputs_overlap_unsafe(add,sum))return false;
+ const auto kp=*norm.kparams<htp_unary_kernel_params>();
+ if(!kp.broadcast_weight||kp.col_tile||!kp.src0_contig||!kp.src1_contig)return false;
+ auto *add_node=add.node;add=norm;add.inputs={a,w,b};add.outputs={out,sum};add.params[7]=0xd10;add.fused.push_back(add_node);
+ HEX_VERBOSE("d1-residual-fused: %lld rows, two outputs\n",(long long)a->ne[1]);
+ static int notices=0;if(notices++<3)GGML_LOG_INFO("d1-residual-active: %lld rows\n",(long long)a->ne[1]);
+ return true;
+}
