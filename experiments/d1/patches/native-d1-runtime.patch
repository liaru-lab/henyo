+// Pinned native graph candidate; copied from validated local graph rewrites.
+// Same host/DSP flags required; private stencil marker is not a generic GGML ABI.
+// Local b11960 experiment. Push selected output henyo_d1_rows through the last block.
+#include "ggml.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+typedef struct ggml_tensor henyo_d1_T;
+static int henyo_d1_enabled(const char *key){const char *p=getenv(key);return p&&atoi(p);}
+static henyo_d1_T *henyo_d1_rows(struct ggml_context *c,henyo_d1_T *a,henyo_d1_T *i){return ggml_get_rows_raw(c,a,i);}
+// 0: clamped seven-row neighborhoods, 1: corresponding zero mask, 2: window ends.
+static void henyo_d1_indices(henyo_d1_T *d,int ith,int nth,void *userdata){
+    (void)nth;if(ith)return;int mode=(int)(intptr_t)userdata;const henyo_d1_T *ids=d->src[0];
+    int n=(int)ggml_nelements(ids);
+    for(int j=0;j<n;++j){int id=((const int32_t *)ids->data)[j];if(id<0)abort();
+        if(mode==2){((int32_t *)d->data)[j]=7*j+6;continue;}
+        for(int k=0;k<7;++k){int q=id+k-6;
+            if(mode==0)((int32_t *)d->data)[j*7+k]=q<0?0:q;
+            else ((float *)d->data)[j*7+k]=q<0?0.0f:1.0f;
+        }
+    }
+}
+static henyo_d1_T *henyo_d1_index_tensor(struct ggml_context *c,henyo_d1_T *ids,int mode){
+    henyo_d1_T *args[]={ids};int64_t n=ggml_nelements(ids);
+    henyo_d1_T *out=ggml_custom_4d(c,mode==1?GGML_TYPE_F32:GGML_TYPE_I32,mode==1?1:(mode==2?n:7*n),mode==1?7*n:1,1,1,args,1,henyo_d1_indices,1,(void *)(intptr_t)mode);
