+    if(prev&&packed_prev)henyo_d1_saved=(struct henyo_d1_saved){c,ids,prev,packed_prev,ends};
+    static int henyo_d1_matched;if(++henyo_d1_matched<=3)fprintf(stderr,"select-last: %lld -> %lld window rows, output rows=%lld ffn=%d pad=%d\n",(long long)a->ne[1],(long long)n,(long long)ggml_nelements(ids),henyo_d1_enabled("HENYO_D1_SELECT_FFN"),henyo_d1_enabled("HENYO_D1_SELECT_PAD"));
