+struct ggml_tensor *ggml_ssm_conv(struct ggml_context *ctx,struct ggml_tensor *sx,struct ggml_tensor *c) {
+    if(henyo_d1_enabled("HENYO_D1_NPU_STENCIL")&&sx&&sx->op==GGML_OP_PAD&&c&&c->type==GGML_TYPE_F32&&c->ne[0]==7&&c->ne[1]==2048) {
