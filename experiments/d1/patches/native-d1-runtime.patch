+        if(ok&&m&&m->op==GGML_OP_MUL) {
+            struct ggml_tensor *b=m->src[0],*x=m->src[1];
+            if(b&&x&&b->type==GGML_TYPE_F32&&b->ne[0]==2048&&b->op==GGML_OP_VIEW&&x->op==GGML_OP_VIEW&&b->src[0]==x->src[0]&&b->src[0]->ne[0]==6144) {
