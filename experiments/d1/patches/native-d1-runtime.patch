+}
+static henyo_d1_T *henyo_d1_matrix(struct ggml_context *c,henyo_d1_T *w,henyo_d1_T *x){
+    int64_t n=x->ne[1];int pad=henyo_d1_enabled("HENYO_D1_SELECT_PAD")?32:0;
